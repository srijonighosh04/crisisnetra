rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function hasRole(role) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function isAdminOrDispatcher() {
      return hasRole('admin') || hasRole('dispatcher');
    }

    // Users — self-readable, admin-writable
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole('admin'));
      allow write: if hasRole('admin');
    }

    // Incidents
    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdminOrDispatcher();
      allow delete: if hasRole('admin');
    }

    // Hospital alerts
    match /hospital_alerts/{incidentId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDispatcher();
      match /hospitals/{hospitalId} {
        allow read: if isAuthenticated();
        allow write: if isAdminOrDispatcher() || hasRole('hospital');
      }
    }

    // Hospital inventory — hospitals can update their own, all auth can read
    match /hospital_inventory/{hospitalId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDispatcher() || hasRole('hospital');
    }

    // Triage tags — any authenticated volunteer can create; dispatchers can update
    match /triage_tags/{tagId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdminOrDispatcher();
    }

    // Route obstacles — any authenticated user can report; dispatchers can clear
    match /route_obstacles/{obstacleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();   // verification votes
      allow delete: if isAdminOrDispatcher();
    }

    // Weather alerts — read-only for all, written by backend service account
    match /weather_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDispatcher();
    }

    // Ambulance dispatches
    match /ambulance_dispatches/{dispatchId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDispatcher();
    }

    // Volunteers
    match /volunteers/{volunteerId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDispatcher();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDispatcher();
    }
  }
}
